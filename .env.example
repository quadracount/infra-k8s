# Copiar como .env (no se commitea) solo si se quiere cambiar algún valor.
# Sin .env, docker-compose.yml usa estos mismos valores de desarrollo.

RABBITMQ_USER=quadra
RABBITMQ_PASSWORD=quadra
JWT_SECRET=dev-jwt-secret
INTERNAL_API_KEY=dev-internal-key

# Provisional hasta el login de la Fase 4: usuario con el que el BFF hace todas las peticiones
DEV_USER_ID=u-martin

